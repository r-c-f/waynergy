// Set waynergy config xkb_key_offset to 8
//
// The offset is 8, not 7: Linux evdev keycodes are PS/2 set 1 make scancodes
// plus 8, and aligning with them matters beyond plain typing. A Wayland
// compositor composes text from the virtual keyboard's own keymap, but it
// resolves key bindings against evdev numbering. With an offset of 7 the map
// is self-consistent and text comes out correct, while every binding is
// silently shifted by one key: on Hyprland, SUPER+1 fired the SUPER+ESC
// binding and SUPER+space landed on LALT.
//
// XKB keycodes for Windows primaries
//
// Derived from trial and error, and then the eventual realization that 
// these are actually just specially encoded PS/2 set 1 make scancodes:
// - single byte codes are sent unaltered
// - E0-profixed codes are sent as the primary byte OR'd with 0x100.
//
// This may be horribly wrong in some cases, feel free to send corrections
// or extensions for more fancy layouts with more specialized keys

default xkb_keycodes "win" {

    minimum= 8;
    maximum= 1025;

    <ESC> = 0x9;
    <FK01> = 0x43;
    <FK02> = 0x44;
    <FK03> = 0x45;
    <FK04> = 0x46;
